<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Mgx.Cmdlets</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
    <!-- See Mgx.Engine.csproj: CA1416 keeps Windows-only directory APIs out of the
         cross-platform code paths at build time rather than at a customer's runtime. -->
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mgx.IntegrationTests" />
    <InternalsVisibleTo Include="Mgx.E2ETests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management.Automation" Version="7.6.4" PrivateAssets="all" />
    <PackageReference Include="System.IO.Pipelines" Version="10.0.0" GeneratePathProperty="true" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mgx.Engine\Mgx.Engine.csproj" />
  </ItemGroup>

  <Target Name="CopyPipelinesDependency" AfterTargets="Build">
    <Copy SourceFiles="$(PkgSystem_IO_Pipelines)\lib\net10.0\System.IO.Pipelines.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Stage DLLs into the module folder so IDE builds are never stale. Release only, a Debug
       dotnet test would otherwise overwrite a Release-staged module -->

  <Target Name="StageModuleOutput" AfterTargets="Build" DependsOnTargets="CopyPipelinesDependency" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ModuleRoot>$(MSBuildThisFileDirectory)..\..\Modules\M365DSC.mgx</ModuleRoot>
      <DepsDir>$(ModuleRoot)\Dependencies</DepsDir>
    </PropertyGroup>

    <MakeDir Directories="$(DepsDir)" />

    <!-- Cmdlets + Engine to module root -->
    <Copy SourceFiles="$(TargetDir)Mgx.Cmdlets.dll" DestinationFolder="$(ModuleRoot)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)Mgx.Engine.dll" DestinationFolder="$(ModuleRoot)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)Mgx.Cmdlets.pdb" DestinationFolder="$(ModuleRoot)" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)Mgx.Cmdlets.pdb')" />
    <Copy SourceFiles="$(TargetDir)Mgx.Engine.pdb" DestinationFolder="$(ModuleRoot)" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)Mgx.Engine.pdb')" />
    <Copy SourceFiles="$(TargetDir)Mgx.Cmdlets.deps.json" DestinationFolder="$(ModuleRoot)" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)Mgx.Cmdlets.deps.json')" />

    <!-- ALC-isolated dependencies -->
    <Copy SourceFiles="$(TargetDir)Polly.Core.dll" DestinationFolder="$(DepsDir)" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)Polly.Core.dll')" />
    <Copy SourceFiles="$(TargetDir)System.Threading.RateLimiting.dll" DestinationFolder="$(DepsDir)" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)System.Threading.RateLimiting.dll')" />
    <Copy SourceFiles="$(TargetDir)System.IO.Pipelines.dll" DestinationFolder="$(DepsDir)" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)System.IO.Pipelines.dll')" />
  </Target>

</Project>
