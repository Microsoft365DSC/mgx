<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 tests build as a self-executing test host -->
    <OutputType>Exe</OutputType>
    <!-- Assembly name must match the InternalsVisibleTo in Mgx.Engine and Mgx.Cmdlets -->
    <AssemblyName>Mgx.IntegrationTests</AssemblyName>
    <RootNamespace>Mgx.IntegrationTests</RootNamespace>
    <!-- xUnit1051 asks every CancellationToken-accepting call to pass TestContext.Current.CancellationToken.
         Suppressed for the suite merged from upstream, which predates the analyzer. Rewriting the call
         sites would conflict with every future upstream merge for no behavior change -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mgx.Engine\Mgx.Engine.csproj" />
    <ProjectReference Include="..\..\src\Mgx.Cmdlets\Mgx.Cmdlets.csproj" />
  </ItemGroup>

  <!--
    Mgx.Cmdlets references System.Management.Automation with PrivateAssets="all",
    so it does not flow transitively. Tests exercise the PSObject/Hashtable
    conversion paths, so the reference is declared directly here.
  -->
  <ItemGroup>
    <PackageReference Include="System.Management.Automation" Version="7.6.4" />
    <!-- Upstream tests host cmdlets in a real runspace, which needs the full SDK, not just SMA -->
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.4" />
    <!-- Not used directly. Pins the transitive dependency from Microsoft.PowerShell.SDK above
         10.0.6, which carries five high severity advisories -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- The resilience bridge disarms the retry handler inside the SDK own chain, so the test
         runs against the real handler. Pinned to what Microsoft.Graph.Authentication 2.36.1 loads.
         Nothing shipped references Kiota, it reaches users through their own installed SDK -->
    <PackageReference Include="Microsoft.Kiota.Http.HttpClientLibrary" Version="1.21.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Scoped to this one advisory so a future advisory against anything else still surfaces -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-7j59-v9qr-6fq9" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
