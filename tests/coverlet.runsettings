<?xml version="1.0" encoding="utf-8"?>
<!--
  Only Mgx.Engine and Mgx.Cmdlets are measured. The test assemblies and the xUnit
  runner would otherwise dilute the number with code nobody ships.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Mgx.Engine]*,[Mgx.Cmdlets]*</Include>
          <Exclude>[Mgx.IntegrationTests]*,[Mgx.E2ETests]*,[xunit*]*</Exclude>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
          <DeterministicReport>true</DeterministicReport>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
